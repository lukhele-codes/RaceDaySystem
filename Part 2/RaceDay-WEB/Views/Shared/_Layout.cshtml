<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RaceDay</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark rd-navbar">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-lightning-charge-fill"></i> RACE<span>DAY</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto">
                        @{
                            var navRole = Context.Session.GetString("Role");
                            var loggedIn = !string.IsNullOrEmpty(Context.Session.GetString("Token"));
                        }

                        @if (!loggedIn)
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
                        }
                        else if (string.Equals(navRole, "Organiser", StringComparison.OrdinalIgnoreCase))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Organiser" asp-action="Dashboard"><i class="bi bi-speedometer2"></i> Dashboard</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Organiser" asp-action="Events"><i class="bi bi-calendar-event"></i> Events</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Organiser" asp-action="ChooseEvent" asp-route-target="Categories"><i class="bi bi-tags"></i> Categories</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Organiser" asp-action="ChooseEvent" asp-route-target="Enrolments"><i class="bi bi-people"></i> Enrolments</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Organiser" asp-action="ChooseEvent" asp-route-target="Results"><i class="bi bi-trophy"></i> Results</a></li>
                        }
                        else
                                                
                        {
                        <li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="Home"><i class="bi bi-house"></i> Home</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="Events"><i class="bi bi-search"></i> Browse Events</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="MyEvents"><i class="bi bi-calendar-check"></i> My Events</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="MyResults"><i class="bi bi-trophy"></i> My Results</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="Profile"><i class="bi bi-person"></i> Profile</a></li>
                        }
                    </ul>
                    <ul class="navbar-nav ms-auto align-items-lg-center">
                        @if (!string.IsNullOrEmpty(Context.Session.GetString("Token")))
                        {
                            <li class="nav-item">
                                <span class="nav-link">
                                    <i class="bi bi-person-circle"></i> @Context.Session.GetString("FullName")
                                    (@Context.Session.GetString("Role"))
                                </span>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-rd-outline btn-sm" style="color:#fff;border-color:#fff;">Log out</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Log in</a></li>
                            <li class="nav-item"><a class="btn btn-rd btn-sm ms-lg-2" asp-controller="Account" asp-action="Register">Register</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="container py-4">
        @if (TempData["Flash"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                @TempData["Flash"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["FlashError"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show">
                @TempData["FlashError"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="rd-footer">
        &copy; 2026 RaceDay - Running, walking and cycling events across South Africa
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>