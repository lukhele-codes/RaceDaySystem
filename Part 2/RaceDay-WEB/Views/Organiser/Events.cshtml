@model List<RaceDay_WEB.Models.EventDto>
@{
    ViewData["Title"] = "My Events";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0"><i class="bi bi-calendar-event"></i> My Events</h2>
    <a class="btn btn-rd" asp-action="CreateEvent"><i class="bi bi-plus-lg"></i> Create event</a>
</div>

<form method="get" asp-action="Events" class="row g-2 mb-3">
    <div class="col-md-6">
        <input name="search" value="@ViewBag.Search" class="form-control" placeholder="Search events by name..." />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-rd-outline">Search</button>
    </div>
</form>

@if (!Model.Any())
{
    <div class="card rd-card p-4 text-center">
        <p class="mb-0">No events found. Click <strong>Create event</strong> to add your first one.</p>
    </div>
}
else
{
    <div class="card rd-card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Event</th>
                        <th>Date</th>
                        <th>Location</th>
                        <th>Type</th>
                        <th>Distance</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in Model)
                    {
                        <tr>
                            <td><strong>@e.Name</strong></td>
                            <td>@e.EventDate.ToString("dd MMM yyyy, HH:mm")</td>
                            <td>@e.Location</td>
                            <td><span class="status-badge type-@((e.EventType ?? "").ToLower())">@e.EventType</span></td>
                            <td>@e.DistanceKm km</td>
                            <td class="text-end">

                                <a class="btn btn-sm btn-rd" asp-action="Categories" asp-route-eventId="@e.Id">
                                    <i class="bi bi-tags"></i> Categories
                                </a>
                                <a class="btn btn-sm btn-rd" asp-action="Enrolments" asp-route-eventId="@e.Id">
                                    <i class="bi bi-people"></i> Enrolments
                                </a>
                                <a class="btn btn-sm btn-rd" asp-action="Results" asp-route-eventId="@e.Id">
                                    <i class="bi bi-trophy"></i> Results
                                </a>
                                <a class="btn btn-sm btn-rd-outline" asp-action="EditEvent" asp-route-id="@e.Id">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                                <form asp-action="DeleteEvent" asp-route-id="@e.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Delete this event? This cannot be undone.');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i> Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}