@model List<RaceDay_WEB.Models.CategoryDto>
@{
    var ev = (RaceDay_WEB.Models.EventDto)ViewBag.Event;
    ViewData["Title"] = "Categories";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-0"><i class="bi bi-tags"></i> Categories</h2>
        <span class="text-muted">@ev.Name &middot; @ev.EventDate.ToString("dd MMM yyyy")</span>
    </div>
    <div>
        <a class="btn btn-rd-outline me-2" asp-action="Events">Back to events</a>
        <a class="btn btn-rd" asp-action="CreateCategory" asp-route-eventId="@ev.Id"><i class="bi bi-plus-lg"></i> Add category</a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="card rd-card p-4 text-center">
        <p class="mb-0">This event has no categories yet. Click <strong>Add category</strong> (for example 5 km, 10 km or 21 km).</p>
    </div>
}
else
{
    <div class="card rd-card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Category</th>
                        <th>Distance</th>
                        <th>Max participants</th>
                        <th>Entry fee</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td><strong>@c.Name</strong></td>
                            <td>@c.DistanceKm km</td>
                            <td>@c.MaxParticipants</td>
                            <td>R @c.EntryFee.ToString("N2")</td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-rd-outline" asp-action="EditCategory" asp-route-eventId="@ev.Id" asp-route-id="@c.Id">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                                <form asp-action="DeleteCategory" asp-route-eventId="@ev.Id" asp-route-id="@c.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Delete this category?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i> Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}