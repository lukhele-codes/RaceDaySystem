@model RaceDay_WEB.Models.ResultFormViewModel
@{
    var ev = (RaceDay_WEB.Models.EventDto)ViewBag.Event;
    ViewData["Title"] = "Enter result";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card rd-card">
            <div class="card-header"><i class="bi bi-stopwatch"></i> @(Model.ResultId == null ? "Enter result" : "Edit result")</div>
            <div class="card-body p-4">
                <p class="mb-1"><strong>@Model.ParticipantName</strong></p>
                <p class="text-muted">@ev.Name &middot; @Model.CategoryName</p>

                <form asp-action="CaptureResult" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    <input type="hidden" asp-for="EventId" />
                    <input type="hidden" asp-for="CategoryId" />
                    <input type="hidden" asp-for="EnrolmentId" />
                    <input type="hidden" asp-for="ResultId" />
                    <input type="hidden" asp-for="ParticipantName" />
                    <input type="hidden" asp-for="CategoryName" />

                    <div class="mb-3">
                        <label asp-for="FinishTime" class="form-label"></label>
                        <input asp-for="FinishTime" class="form-control" placeholder="00:45:30" />
                        <span asp-validation-for="FinishTime" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Position" class="form-label"></label>
                        <input asp-for="Position" type="number" class="form-control" />
                        <span asp-validation-for="Position" class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-rd">Save result</button>
                        <a class="btn btn-rd-outline" asp-action="Results"
                           asp-route-eventId="@Model.EventId" asp-route-categoryId="@Model.CategoryId">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}