@model List<RaceDay_WEB.Models.EventDto>
@{
    ViewData["Title"] = "Browse Events";
    var type = (string?)ViewBag.Type ?? "";
}

<h2 class="mb-4"><i class="bi bi-search"></i> Browse Events</h2>

<form method="get" asp-action="Events" class="row g-2 mb-4">
    <div class="col-md-5">
        <input name="search" value="@ViewBag.Search" class="form-control" placeholder="Search events by name..." />
    </div>
    <div class="col-md-3">
        <select name="type" class="form-select">
            <option value="" selected="@(type == "")">All types</option>
            <option value="Run" selected="@(type == "Run")">Run</option>
            <option value="Walk" selected="@(type == "Walk")">Walk</option>
            <option value="Cycle" selected="@(type == "Cycle")">Cycle</option>
        </select>
    </div>
    <div class="col-auto"><button type="submit" class="btn btn-rd">Search</button></div>
    <div class="col-auto"><a class="btn btn-rd-outline" asp-action="Events">Clear</a></div>
</form>

@if (!Model.Any())
{
    <div class="card rd-card p-4 text-center"><p class="mb-0">No events match your search.</p></div>
}
else
{
    <div class="row g-4">
        @foreach (var e in Model)
        {
            <div class="col-md-4">
                <div class="card rd-card h-100">
                    <div class="event-banner type-@((e.EventType ?? "").ToLower())"><i class="bi @RaceDay_WEB.Models.UiHelpers.TypeIcon(e.EventType)"></i></div>
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="mb-0">@e.Name</h5>
                            <span class="status-badge type-@((e.EventType ?? "").ToLower())">@e.EventType</span>
                        </div>
                        <p class="text-muted mb-1"><i class="bi bi-calendar3"></i> @e.EventDate.ToString("dd MMM yyyy, HH:mm")</p>
                        <p class="text-muted mb-1"><i class="bi bi-geo-alt"></i> @e.Location</p>
                        <p class="text-muted mb-3"><i class="bi bi-signpost-2"></i> @e.DistanceKm km</p>
                        <a class="btn btn-rd mt-auto" asp-action="EventDetail" asp-route-id="@e.Id">View details</a>
                    </div>
                </div>
            </div>
        }
    </div>
}